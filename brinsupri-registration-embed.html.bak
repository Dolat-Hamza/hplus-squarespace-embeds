let currentLang = (function(){ try{ return localStorage.getItem('hplus_lang')||'de'; }catch(e){ return 'de'; } })();
const t = k => (I18N[currentLang][k] ?? I18N.de[k] ?? k);

const MEDS={
  "Brinsupri (Brensocatib)":{de:{dose:"25 mg Filmtablette",frequency:"Eine Tablette täglich",administration:"Oral"},en:{dose:"25 mg film-coated tablet",frequency:"One tablet daily",administration:"Oral"}},
  "Revestive (Teduglutide)":{de:{dose:"0,05 mg/kg",frequency:"Einmal täglich",administration:"Subkutane Injektion (unter die Haut)"},en:{dose:"0.05 mg/kg",frequency:"Once daily",administration:"Subcutaneous (under the skin) injection"}},
  "Takhzyro (Lanadelumab)":{de:{dose:"300 mg",frequency:"Alle 2 Wochen",administration:"Subkutane Injektion (unter die Haut)"},en:{dose:"300 mg",frequency:"Every 2 weeks",administration:"Subcutaneous (under the skin) injection"}},
  "Galafold (Migalastat)":{de:{dose:"123 mg",frequency:"Jeden zweiten Tag",administration:"Oral (nüchtern einzunehmen)"},en:{dose:"123 mg",frequency:"Once every other day",administration:"Oral (on an empty stomach)"}},
  "Vyvgart (Efgartigimod alfa)":{de:{dose:"10 mg/kg",frequency:"Einmal wöchentlich (4 Wochen pro Zyklus)",administration:"Intravenöse Infusion"},en:{dose:"10 mg/kg",frequency:"Once weekly (4 weeks per cycle)",administration:"Intravenous infusion"}},
  "Zilbrysq (Zilucoplan)":{de:{dose:"0,3 mg/kg (gewichtsbasiert)",frequency:"Einmal täglich",administration:"Subkutane Injektion (unter die Haut)"},en:{dose:"0.3 mg/kg (weight-based)",frequency:"Once daily",administration:"Subcutaneous (under the skin) injection"}}
};
function fillMed(lang){
  var sel=document.getElementById('med_select');
  var name=sel?sel.value:HS.med.medicine;
  var m=MEDS[name]; if(!m) return;
  var d=m[lang]||m.de;
  HS.med.medicine=name; HS.med.dose=d.dose; HS.med.frequency=d.frequency; HS.med.administration=d.administration;
  var e;
  if(e=document.getElementById('mdName')) e.textContent=name;
  if(e=document.getElementById('mdDose')) e.textContent=d.dose;
  if(e=document.getElementById('mdFreq')) e.textContent=d.frequency;
  if(e=document.getElementById('mdAdmin')) e.textContent=d.administration;
}
function applyLang(lang){
  currentLang=lang;
  try{ localStorage.setItem('hplus_lang',lang); }catch(e){}
  document.documentElement.lang=lang;
  document.querySelectorAll('[data-i18n]').forEach(el=>{ el.textContent=t(el.dataset.i18n); });
  document.querySelectorAll('[data-i18n-html]').forEach(el=>{ el.innerHTML=t(el.dataset.i18nHtml); });
  document.querySelectorAll('[data-i18n-ph]').forEach(el=>{ el.placeholder=t(el.dataset.i18nPh); });
  document.querySelectorAll('.langswitch button').forEach(b=>b.classList.toggle('active',b.dataset.lang===lang));
  setSubTag();
  if(typeof updateConsentTexts==='function') updateConsentTexts();
  fillMed(currentLang);
  if(current===4) buildReview();
}
document.querySelectorAll('.langswitch button').forEach(b=>b.addEventListener('click',()=>applyLang(b.dataset.lang)));
(function(){var s=document.getElementById('med_select');function reset(){if(s){s.value='Brinsupri (Brensocatib)';fillMed(currentLang);}}if(s)s.addEventListener('change',function(){fillMed(currentLang);if(current===4)buildReview();});reset();window.addEventListener('pageshow',reset);})();

/* helpers */
const $ = id => document.getElementById(id);
const val = id => (($(id)||{}).value||'').trim();
const checked = id => !!($(id)||{}).checked;
const multi = sel => [...document.querySelectorAll(sel)].filter(c=>c.checked).map(c=>c.value).join(';');
const radio = name => (document.querySelector(`input[name="${name}"]:checked`)||{}).value||'';
const toEpoch = d => { if(!d) return ''; const [y,m,day]=d.split('-').map(Number); return String(Date.UTC(y,m-1,day)); };
const field = (name,value)=>({objectTypeId:'0-1',name,value:String(value)});

/* conditional UI — step 1 */
function syncCommFields(){
  $('c_whatsapp').style.display=document.querySelector('#comm_prefs input[value=Whatsapp]').checked?'block':'none';
  $('c_phone').style.display=document.querySelector('#comm_prefs input[value=Phone]').checked?'block':'none';
  $('c_sms').style.display=document.querySelector('#comm_prefs input[value=SMS]').checked?'block':'none';
}
document.querySelectorAll('#comm_prefs input').forEach(c=>c.addEventListener('change',syncCommFields));
/* caregiver contact fields — same pattern as the patient's: only show the ones selected */
function syncCgCommFields(){
  $('c_sc_email').style.display=document.querySelector('#cg_comm_prefs input[value=Email]').checked?'block':'none';
  $('c_sc_whatsapp').style.display=document.querySelector('#cg_comm_prefs input[value=Whatsapp]').checked?'block':'none';
  $('c_sc_phone').style.display=document.querySelector('#cg_comm_prefs input[value=Phone]').checked?'block':'none';
  $('c_sc_sms').style.display=document.querySelector('#cg_comm_prefs input[value=SMS]').checked?'block':'none';
}
document.querySelectorAll('#cg_comm_prefs input').forEach(c=>c.addEventListener('change',syncCgCommFields));
/* second-person details show when role = Caregiver OR reminders wanted for a second person */
function syncSecondPerson(){ $('caregiverBlock').style.display = (val('customer_type')==='Caregiver' || radio('second_person')==='Yes') ? 'block' : 'none'; }
document.querySelectorAll('input[name=second_person]').forEach(r=>r.addEventListener('change',syncSecondPerson));
$('customer_type').addEventListener('change',syncSecondPerson);
document.querySelectorAll('.choice input').forEach(inp=>{
  const paint=()=>{ const c=inp.closest('.choice'); if(inp.type==='radio'){document.querySelectorAll(`input[name="${inp.name}"]`).forEach(o=>o.closest('.choice').classList.remove('selected'));} c.classList.toggle('selected',inp.checked); };
  inp.addEventListener('change',paint); paint();
});

/* check-in frequency: fully optional — no option selected by default; click a selected
   option to turn it off again. State is read live per-click (via mousedown snapshot) so it
   stays correct even after the radios are cleared programmatically (e.g. "no support"). */
(function(){
  document.querySelectorAll('input[name="reminder_freq"]').forEach(r=>{
    // Snapshot on the LABEL press so it fires for a click anywhere in the row
    // (the radio dot is only ~20px of the hit area — most clicks land on the label text).
    const label=r.closest('label')||r;
    label.addEventListener('mousedown',()=>{ r._wasChecked=r.checked; });
    label.addEventListener('touchstart',()=>{ r._wasChecked=r.checked; },{passive:true});
    r.addEventListener('click',()=>{
      if(r._wasChecked){ r.checked=false; r.dispatchEvent(new Event('change',{bubbles:true})); }
      r._wasChecked=r.checked;
    });
  });
})();

/* conditional UI — step 3 options + consent visibility */
function syncOptions(){
  ['delivery','rx','checkup'].forEach(k=>{});
  $('card_delivery').classList.toggle('selected',checked('delivery_management'));
  $('card_rx').classList.toggle('selected',checked('prescription_management'));
  $('card_checkup').classList.toggle('selected',checked('check_up_reminder_management'));
  /* Appointment reminders require a date in the backing form, so reveal the
     matching date question whenever that service is selected. */
  $('apptWrap').style.display=checked('check_up_reminder_management')?'block':'none';
  if(!checked('check_up_reminder_management')) $('apptWrap').classList.remove('invalid');
  $('rxNote').style.display=checked('prescription_management')?'block':'none';
  $('deliveryNote').style.display=checked('delivery_management')?'block':'none';
}
function syncConsentVisibility(){
  updateConsentTexts();   // consent pages are shown/hidden by the sub-step router
}
/* Consent text is country-specific: Germany uses the full legal wording + pharmacy choice. */
function updateConsentTexts(){
  const country = val('country'), de = country==='Deutschland', at = country==='Österreich';
  $('deliveryTermsLink').href=at?'/therapy-companion/delivery-and-collection-services-at':'/therapy-companion/delivery-and-collection-services-de';
  /* Germany and Austria now use the same pharmacy-choice journey. Country-specific
     legal wording remains available through the terms hyperlink. */
  const showPharm = (de||at) && (checked('delivery_management')||checked('prescription_management')) && checked('delivery_consent');
  $('pharmacyBlock').style.display = showPharm ? 'block' : 'none';
  $('pharmHplusTxt').textContent = t('pharmacy_hplus');
  $('freeChoiceH').textContent = t(at?'freechoice_h_at':'freechoice_h');
  $('freeChoiceP').textContent = t(at?'freechoice_p_at':'freechoice_p');
  $('pharmAddress').textContent = PARTNER_PHARMACY;
  $('altPharmacy').style.display = (showPharm && radio('pharmacy_choice')==='no') ? 'block' : 'none';
}
['delivery_management','prescription_management','check_up_reminder_management','no_support','country'].forEach(id=>$(id).addEventListener('change',()=>{ syncOptions(); syncConsentVisibility(); }));
$('delivery_consent').addEventListener('change',updateConsentTexts);
document.querySelectorAll('input[name=pharmacy_choice]').forEach(r=>r.addEventListener('change',updateConsentTexts));
/* Germany pharmacy choice — steer toward the H+ partner pharmacy (CRO nudge) */
(function(){
  const yes=document.querySelector('input[name="pharmacy_choice"][value="yes"]');
  const no =document.querySelector('input[name="pharmacy_choice"][value="no"]');
  if(!yes||!no) return;
  const paintPharma=()=>{ $('pharmaHero').classList.toggle('is-selected',yes.checked); $('pharmaMini').classList.toggle('is-selected',no.checked); };
  const openAlt =()=>$('altPharmacyModal').classList.add('open');
  const closeAlt=()=>$('altPharmacyModal').classList.remove('open');
  yes.addEventListener('change',paintPharma);
  no.addEventListener('change',()=>{ paintPharma(); if(no.checked) openAlt(); });
  // also fire on plain clicks (covers the case where "no" is already selected — no change event)
  $('pharmaMini').addEventListener('click',()=>{ setTimeout(()=>{ paintPharma(); if(no.checked) openAlt(); },0); });
  // Yes → keep H+ services (select the recommended pharmacy); No → keep own pharmacy. Both close.
  $('altpmYes').addEventListener('click',()=>{ yes.checked=true; yes.dispatchEvent(new Event('change',{bubbles:true})); closeAlt(); });
  $('altpmNo').addEventListener('click',closeAlt);
  $('altPharmacyModal').addEventListener('click',e=>{ if(e.target===$('altPharmacyModal')) closeAlt(); });
  document.addEventListener('keydown',e=>{ if(e.key==='Escape' && $('altPharmacyModal').classList.contains('open')) closeAlt(); });
  paintPharma();
})();
$('no_support').addEventListener('change',()=>{ if(checked('no_support')){['delivery_management','prescription_management','check_up_reminder_management'].forEach(id=>{$(id).checked=false;$(id).dispatchEvent(new Event('change'));}); document.querySelectorAll('input[name="reminder_freq"]').forEach(r=>{ r.checked=false; r._wasChecked=false; r.closest('.choice').classList.remove('selected'); });}});
['delivery_management','prescription_management','check_up_reminder_management'].forEach(id=>$(id).addEventListener('change',()=>{ if(checked(id)){$('no_support').checked=false;$('no_support').closest('.choice').classList.remove('selected');}}));
$('arrange_call').addEventListener('change',()=>{ $('callbackWhen').style.display=checked('arrange_call')?'block':'none'; });

/* ---- date bounds: first dose (2 Jul → +3 months) · callback (+48h → +7 days) ---- */
const ymd=d=>{const z=n=>String(n).padStart(2,'0');return d.getFullYear()+'-'+z(d.getMonth()+1)+'-'+z(d.getDate());};
function setupDates(){
  const today=new Date();
  const fd=$('first_medication_date'); const maxDose=new Date(today); maxDose.setMonth(maxDose.getMonth()+3);
  fd.min='2026-07-02'; fd.max=ymd(maxDose);
  const ap=$('appointment_date'); if(ap){ ap.min=ymd(today); }
  const cb=$('callback_date'); const minCb=new Date(today); minCb.setDate(minCb.getDate()+2); const maxCb=new Date(today); maxCb.setDate(maxCb.getDate()+7);
  cb.min=ymd(minCb); cb.max=ymd(maxCb);
}

/* ---- doctor practice search (Google Places UI Kit — PlaceAutocompleteElement) ---- */
let placesLoaded=false, placesInited=false;
/* Official Google dynamic-library bootstrap loader — required for PlaceAutocompleteElement. */
function loadPlaces(cb){
  if(placesLoaded){ cb(); return; }
  if(!GOOGLE_MAPS_API_KEY){ cb('nokey'); return; }
  ((g)=>{var h,a,k,p="The Google Maps JavaScript API",c="google",l="importLibrary",q="__ib__",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise(async(f,n)=>{await (a=m.createElement("script"));e.set("libraries",[...r]+"");for(k in g)e.set(k.replace(/[A-Z]/g,(t)=>"_"+t[0].toLowerCase()),g[k]);e.set("callback",c+".maps."+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+" could not load."));a.nonce=m.querySelector("script[nonce]")?.nonce||"";m.head.append(a)}));d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})({key:GOOGLE_MAPS_API_KEY,v:"weekly"});
  placesLoaded=true; cb();
}
function fillFromComponents(comps, name, phone){
  const street=[comps.route, comps.street_number].filter(Boolean).join(' ');
  if(name)  $('doctor_street2').value=name;
  if(street)$('doctor_street').value=street;
  if(comps.postal_code) $('doctor_postcode').value=comps.postal_code;
  if(comps.locality) $('doctor_street').value = ($('doctor_street').value ? $('doctor_street').value+', ' : '') + comps.locality;
  if(phone){
    // Google returns the full international number (e.g. "+49 30 1234567"); the field
    // already has a country-code selector, so strip the leading +CC to avoid doubling it.
    let p=String(phone).trim();
    const m=p.match(/^\+(\d{1,3})[\s\-]*(.*)$/);
    if(m){ const cc='+'+m[1], nat=m[2].replace(/\s+/g,' ').trim();
      const sel=$('doctor_phone_cc'); if(sel && [...sel.options].some(o=>o.value===cc)){ sel.value=cc; sel.dataset.touched='1'; }
      $('doctor_phone').value=nat;
    } else { $('doctor_phone').value=p; }
  }
  $('addressFields').style.display='block';
}
function placesFailed(msg){
  console.error('[Places] '+msg);
  $('addressFields').style.display='block';           // let the patient enter the address manually
  const box=$('practiceSearchBox'); if(box){ box.style.display='block'; box.querySelector('.reassure span').textContent = t('practice_search_err'); }
}
async function initAutocomplete(){
  if(placesInited) return; placesInited=true;
  const at=val('country')==='Österreich';
  try{
    const { PlaceAutocompleteElement } = await google.maps.importLibrary('places');
    const pac = new PlaceAutocompleteElement({ includedRegionCodes:[at?'at':'de'] });
    pac.style.width='100%';
    const box=$('practiceSearchBox');
    $('practiceSearch').style.display='none';
    box.insertBefore(pac, box.firstChild);
    // user picks a prediction → fetch details → fill address fields
    pac.addEventListener('gmp-select', async (ev)=>{
      try{
        const pred = ev.placePrediction || (ev.detail && ev.detail.placePrediction);
        const place = pred.toPlace();
        await place.fetchFields({ fields:['displayName','addressComponents','internationalPhoneNumber'] });
        const comps={}; (place.addressComponents||[]).forEach(c=>(c.types||[]).forEach(ty=>comps[ty]=c.longText));
        fillFromComponents(comps, place.displayName, place.internationalPhoneNumber);
      }catch(e){ placesFailed('fetchFields error: '+e.message); }
    });
    pac.addEventListener('gmp-error', ()=>placesFailed('PlaceAutocompleteElement error event'));
  }catch(e){ placesFailed('init failed — enable "Places API (New)" for the key. '+e.message); }
}
$('practiceSearchBtn').addEventListener('click',()=>{
  $('practiceSearchBox').style.display='block';
  loadPlaces(err=>{ if(err==='nokey'){ $('practiceSearchBox').style.display='none'; $('addressFields').style.display='block'; } else initAutocomplete(); });
});
/* can't find details → reveal callback option (button stays available) */
$('cantFindBtn').addEventListener('click',()=>{ $('addressFields').style.display='block'; $('callbackBox').style.display='block'; $('addressFields').scrollIntoView({behavior:'smooth',block:'start'}); });

/* ---- no-support confirmation modal ---- */
function openNoSupportModal(){ $('noSupportModal').classList.add('open'); }
function closeNoSupportModal(){ $('noSupportModal').classList.remove('open'); }
$('nsConfirm').addEventListener('click',()=>{ closeNoSupportModal(); finishStep3(); });
$('nsBack').addEventListener('click',()=>{ closeNoSupportModal(); $('no_support').checked=false; $('no_support').closest('.choice').classList.remove('selected'); });
// dismiss on backdrop click or Escape (treated as "reconsider")
$('noSupportModal').addEventListener('click',e=>{ if(e.target===$('noSupportModal')){ closeNoSupportModal(); $('no_support').checked=false; $('no_support').closest('.choice').classList.remove('selected'); } });
document.addEventListener('keydown',e=>{ if(e.key==='Escape' && $('noSupportModal').classList.contains('open')){ closeNoSupportModal(); $('no_support').checked=false; $('no_support').closest('.choice').classList.remove('selected'); } });

/* ============================================================
   MAIN STEP NAVIGATION (4 steps). Progress steps clickable.
   ============================================================ */
let current=1, sub3=1; const totalSteps=4;
const emailOk = e => { const v=String(e||'').trim(); return v.length<=254 && /^[^\s@]{1,64}@[^\s@]+\.[A-Za-z]{2,}$/.test(v); };
/* Diagnostic logging intentionally excludes names, email addresses and medical details. */
const step3Log=(message,details)=>console.log('[H+ Step 3] '+message,details||'');
function setSubTag(){ const el=$('subTag'); if(el) el.textContent=t('sub_of').replace('%s',sub3); }
function showSub3(n){
  sub3=n; ['sub31','sub32','sub33','sub34'].forEach((id,i)=>$(id).classList.toggle('active',i===n-1));
  if(n===4){ const cc=val('country')==='Österreich'?'+43':'+49'; ['doctor_phone_cc','doctor_fax_cc'].forEach(id=>{ if($(id) && !$(id).dataset.touched) $(id).value=cc; }); }
  document.querySelector('.card').scrollIntoView({behavior:'smooth',block:'start'});
}
document.querySelectorAll('#doctor_phone_cc,#doctor_fax_cc').forEach(sel=>sel.addEventListener('change',()=>sel.dataset.touched='1'));
function showStep(n){
  current=n;
  $('noSupportModal').classList.remove('open');   // never leave the confirm modal blocking clicks after navigation
  document.querySelectorAll('.step').forEach(s=>s.classList.toggle('active',+s.dataset.step===n));
  $('progressLine').style.width=(n/totalSteps*100)+'%';
  document.querySelectorAll('#progressSteps li').forEach(li=>{const s=+li.dataset.s;li.classList.toggle('active',s===n);li.classList.toggle('done',s<n);});
  if(n===3) showSub3(1);
  if(n===4) buildReview();
  document.querySelector('.card').scrollIntoView({behavior:'smooth',block:'start'});
}
document.querySelectorAll('#progressSteps li').forEach(li=>li.addEventListener('click',()=>showStep(+li.dataset.s)));

function markInvalid(el,bad){ el.classList.toggle('invalid',bad); }
function showErr(id,show){ $(id).classList.toggle('show',show); }

/* ---- format validators (mirror the HubSpot phone/email checks) ---- */
/* country-aware: DE national numbers run 6–11 digits, AT 4–13 (after stripping a leading 0) */
function phoneOk(v,cc){
  const d=v.replace(/\D/g,'').replace(/^0+/,'');
  if(!/^[+()\-.\s\/0-9]+$/.test(v)) return false;
  return cc==='+43' ? /^[1-9]\d{3,12}$/.test(d) : /^[1-9]\d{5,10}$/.test(d);
}
/* WhatsApp accepts any valid international E.164-style number. */
function globalPhoneOk(v){ const compact=v.replace(/[\s().\-/]/g,''); return /^\+[1-9]\d{7,14}$/.test(compact); }
function formatOk(inp){ const v=inp.value.trim(); return inp.dataset.validate==='email'?emailOk(v):inp.dataset.validate==='phone-global'?globalPhoneOk(v):phoneOk(v,ccOf(inp)); }
function formatErrorKey(inp){ return inp.dataset.validate==='email'?'err_email_fmt':inp.dataset.validate==='phone-global'?'err_whatsapp_global':'err_phone'; }
function ccOf(inp){ const sel=document.getElementById(inp.id+'_cc'); return sel?sel.value:'+49'; }
/* compose the full number (country code + national number) for submission */
function phoneFull(id){
  const inp=$(id); if(!inp) return '';
  const v=inp.value.trim(); if(!v) return '';
  if(inp.dataset.validate==='phone-global') return '+'+v.replace(/\D/g,'');
  return (ccOf(inp)+' '+v.replace(/^0+/,'')).trim();
}
function ensureFmtErr(f,msg){ let e=f.querySelector('.err-msg.fmt'); if(!e){ e=document.createElement('div'); e.className='err-msg fmt'; f.appendChild(e);} e.textContent=msg; }
function clearScope(scope){ scope.querySelectorAll('.field.invalid').forEach(f=>f.classList.remove('invalid')); scope.querySelectorAll('.err-msg.fmt').forEach(e=>e.remove()); }
/* validate every visible, filled [data-validate] input in scope */
function validateFormats(scope){
  let ok=true;
  scope.querySelectorAll('input[data-validate]').forEach(inp=>{
    const f=inp.closest('.field'); if(!f || f.offsetParent===null) return;    // skip hidden
    const v=inp.value.trim(); if(!v) return;                                   // empty → required logic handles it
    const bad = !formatOk(inp);
    if(bad){ f.classList.add('invalid'); ensureFmtErr(f,t(formatErrorKey(inp))); ok=false; }
  });
  return ok;
}
/* require a field when a condition is met (e.g. contact number for a chosen method) */
function requireIf(inputId, cond){
  if(!cond) return true;
  const inp=$(inputId), f=inp.closest('.field');
  if(inp.value.trim()===''){ f.classList.add('invalid'); ensureFmtErr(f,t('err_required')); return false; }
  return true;
}

/* generic validation for steps 1 & 2 */
function validateStep(n){
  let ok=true;
  const stepEl=document.querySelector(`.step[data-step="${n}"]`);
  clearScope(stepEl);
  stepEl.querySelectorAll('.field[data-required]').forEach(f=>{
    let bad=false;
    if(f.dataset.group==='comm'){ bad=multi('#comm_prefs input')===''; }
    else{
      const input=f.querySelector('input[type=text],input[type=email],input[type=date],select,textarea');
      const radios=f.querySelectorAll('input[type=radio]');
      const cb=f.querySelector('input[type=checkbox]');
      if(radios.length){ bad=![...radios].some(r=>r.checked); }
      else if(cb && !input){ bad=!cb.checked; }
      else if(input){ bad=input.value.trim()===''; }   // format (email/phone) is validated exclusively by validateFormats() below — avoids duplicate error messages
    }
    markInvalid(f,bad);
    if(bad){
      ok=false;
      const dv=f.querySelector('input[data-validate]');
      if(dv) ensureFmtErr(f, t(dv.dataset.validate==='email'?'err_email':'err_required'));  // empty required field with no static message (e.g. email) still gets one
    }
  });
  if(!validateFormats(stepEl)) ok=false;
  if(n===1){
    const cm=v=>document.querySelector(`#comm_prefs input[value=${v}]`).checked;
    if(!requireIf('patient_whatsapp',cm('Whatsapp'))) ok=false;
    if(!requireIf('patient_phone',cm('Phone'))) ok=false;
    if(!requireIf('patient_sms',cm('SMS'))) ok=false;
    if(radio('second_person')==='Yes'){
      const cg=v=>document.querySelector(`#cg_comm_prefs input[value=${v}]`).checked;
      if(!requireIf('second_contact_whatsapp',cg('Whatsapp'))) ok=false;
      if(!requireIf('second_contact_phone',cg('Phone'))) ok=false;
      if(!requireIf('caregiver_sms',cg('SMS'))) ok=false;
      if(!requireIf('second_contact_email',cg('Email'))) ok=false;
    }
  }
  if(n===2){
    const fd=$('first_medication_date'), fv=fd.value;
    if(fv && ((fd.min && fv<fd.min) || (fd.max && fv>fd.max))){ const f=fd.closest('.field'); f.classList.add('invalid'); ensureFmtErr(f,t('err_date_range')); ok=false; }
  }
  return ok;
}

/* step-3 sub validation */
function validateSub3(n){
  let ok=true;
  step3Log('Validating section '+n,{
    countrySelected:val('country')!=='',
    delivery:checked('delivery_management'),
    prescription:checked('prescription_management'),
    appointments:checked('check_up_reminder_management'),
    checkInFrequencySelected:radio('reminder_freq')!=='',
    noSupport:checked('no_support')
  });
  if(n===1){
    const cf=$('country').closest('.field'); const countryBad=val('country')==='';
    markInvalid(cf,countryBad); if(countryBad){ ok=false; }
    /* A check-in frequency is itself a valid service choice. Previously the UI let
       patients select one, but validation still treated the page as unanswered. */
    const anyOpt=checked('delivery_management')||checked('prescription_management')||checked('check_up_reminder_management')||radio('reminder_freq')!==''||checked('no_support');
    showErr('optionsErr',!anyOpt); if(!anyOpt) ok=false;
    // repeat prescriptions require delivery too (user must actively opt in)
    const rxNeedsDelivery = checked('prescription_management') && !checked('delivery_management');
    $('rxNote').classList.toggle('note-error',rxNeedsDelivery);
    if(rxNeedsDelivery){ ok=false; $('card_delivery').scrollIntoView({behavior:'smooth',block:'center'}); }
    showErr('freqErr',false);   // check-in frequency is optional — choosing none is fine
    // appointment date required when check-up reminders selected (mirrors HubSpot rule)
    if(checked('check_up_reminder_management')){
      const af=$('appointment_date').closest('.field'); const bad=val('appointment_date')==='';
      markInvalid(af,bad); if(bad){ ok=false; af.scrollIntoView({behavior:'smooth',block:'center'}); }
    }
  }
  if(n===2){   // DELIVERY consent page (shown when delivery || rx)
    clearScope($('sub32')); showErr('pharmacyErr',false);
    const bad=!checked('delivery_consent'); markInvalid($('deliveryConsentWrap'),bad); if(bad) ok=false;
    // Germany and Austria: pharmacy choice required once delivery consent is given
    if((val('country')==='Deutschland'||val('country')==='Österreich') && checked('delivery_consent')){
      const ph=radio('pharmacy_choice');
      showErr('pharmacyErr', ph===''); if(ph==='') ok=false;
      if(ph==='no'){
        ['chosen_pharmacy_name','chosen_pharmacy_street','chosen_pharmacy_city','chosen_pharmacy_postcode'].forEach(id=>{
          if(val(id)===''){ const f=$(id).closest('.field'); f.classList.add('invalid'); ensureFmtErr(f,t('err_required')); ok=false; }
        });
      }
    }
  }
  if(n===3){   // PRESCRIPTION consent page (shown when rx)
    clearScope($('sub33'));
    const bad=!checked('hcp_consent'); markInvalid($('hcpConsentWrap'),bad); if(bad) ok=false;
  }
  if(n===4){   // DOCTOR details page
    clearScope($('sub34')); $('callbackErr').classList.remove('show');
    if(checked('arrange_call')){
      const cv=val('callback_date'), cbEl=$('callback_date');
      if(cv===''){ markInvalid($('callbackWhen'),true); ok=false; }
      else if((cbEl.min && cv<cbEl.min) || (cbEl.max && cv>cbEl.max)){ $('callbackWhen').classList.add('invalid'); $('callbackErr').textContent=t('err_callback_range'); $('callbackErr').classList.add('show'); ok=false; }
      showErr('infoErr',false);
    } else {
      const complete = val('doctor_first') && val('doctor_last') && (val('doctor_street')||val('doctor_postcode')||val('doctor_street2')||val('doctor_phone')||val('doctor_email'));
      if(!complete){ showErr('infoErr',true); ok=false; $('cantFindBtn').scrollIntoView({behavior:'smooth',block:'center'}); }
      else showErr('infoErr',false);
    }
    if(!validateFormats($('sub34'))) ok=false;
  }
  step3Log(ok?'Validation passed':'Validation blocked Continue',{section:n});
  return ok;
}
/* routing within step 3 (conditional 4-page sub-flow) — delivery form is sent on completion */
/* Do not hold the interface on step 3 while the progressive save is in flight.
   The save still starts immediately and is awaited by the caller, but the user
   receives instant visual feedback by moving to the review step first. */
async function finishStep3(){
  step3Log('Moving to Confirm and saving Step 3 in the background');
  const saving=sendStep('delivery');
  showStep(4);
  const saved=await saving;
  step3Log(saved?'Background save completed':'Background save failed; final submission will retry');
}
function showStep3Blocker(from){
  const scope=$('sub3'+from);
  const blocker=scope&&scope.querySelector('.field.invalid,.err-msg.show,.note-error');
  step3Log('Continue stopped by a required or conditional field',{section:from,blocker:blocker?(blocker.id||blocker.className):'not identified'});
  if(blocker) blocker.scrollIntoView({behavior:'smooth',block:'center'});
}
async function step3Next(from){
  const delivery=checked('delivery_management'), rx=checked('prescription_management'), none=checked('no_support');
  step3Log('Continue clicked',{section:from,delivery,prescription:rx,noSupport:none});
  if(from===1){ if(!validateSub3(1)){showStep3Blocker(1);return;} if(none){step3Log('Opening no-support confirmation');openNoSupportModal();} else if(!delivery&&!rx){await finishStep3();} else {step3Log('Opening delivery consent');showSub3(2);} return; }
  if(from===2){ if(!validateSub3(2)){showStep3Blocker(2);return;} if(rx){step3Log('Opening prescription consent');showSub3(3);} else {await finishStep3();} return; }  // delivery consent → hcp consent (if rx) else review
  if(from===3){ if(!validateSub3(3)){showStep3Blocker(3);return;} step3Log('Opening doctor details');showSub3(4);return; }                                          // hcp consent → doctor
  if(from===4){ if(!validateSub3(4)){showStep3Blocker(4);return;} await finishStep3();return; }                                  // doctor → review
}
function step3Back(from){ if(from===1){ showStep(2); } else if(from===2){ showSub3(1); } else if(from===3){ showSub3(2); } else if(from===4){ showSub3(3); } }
function runStep3Next(n){ step3Next(n).catch(e=>console.error('[H+ Step 3] Navigation error in section '+n,e)); }
$('s3next1').addEventListener('click',()=>runStep3Next(1));
$('s3next2').addEventListener('click',()=>runStep3Next(2));
$('s3next3').addEventListener('click',()=>runStep3Next(3));
$('s3next4').addEventListener('click',()=>runStep3Next(4));
$('s3back1').addEventListener('click',()=>step3Back(1));
$('s3back2').addEventListener('click',()=>step3Back(2));
$('s3back3').addEventListener('click',()=>step3Back(3));
$('s3back4').addEventListener('click',()=>step3Back(4));

/* full step-3 validation for final submit */
function validateStep3All(){
  if(!validateSub3(1)){ showStep(3); showSub3(1); return false; }
  const delivery=checked('delivery_management'), rx=checked('prescription_management'), none=checked('no_support');
  if(!none && (delivery||rx)){ if(!validateSub3(2)){ showStep(3); showSub3(2); return false; } }
  if(rx){
    if(!validateSub3(3)){ showStep(3); showSub3(3); return false; }
    if(!validateSub3(4)){ showStep(3); showSub3(4); return false; }
  }
  return true;
}

document.querySelectorAll('[data-next]').forEach(b=>b.addEventListener('click',async ()=>{
  if(!validateStep(current)){ document.querySelector('.step.active .invalid')?.scrollIntoView({behavior:'smooth',block:'center'}); return; }
  if(current===1) await sendStep('registration');   // send each form as its step completes
  if(current===2) await sendStep('medical');
  showStep(current+1);
}));
document.querySelectorAll('[data-prev]').forEach(b=>b.addEventListener('click',()=>showStep(current-1)));

/* ============================================================
   REVIEW
   ============================================================ */
function esc(s){return (s||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
function buildReview(){
  const commLabels={Email:t('opt_email'),Whatsapp:'WhatsApp',Phone:t('opt_phone'),SMS:'SMS'};
  const comm=multi('#comm_prefs input').split(';').filter(Boolean).map(v=>commLabels[v]).join(', ');
  const freqLabels={'Weekly (recommended especially in the beginning)':t('freq_weekly'),'Every two weeks':t('freq_2w'),'Every four weeks':t('freq_monthly')};
  const support=[];
  if(checked('delivery_management'))support.push(t('sup_delivery'));
  if(checked('prescription_management'))support.push(t('sup_rx'));
  if(checked('check_up_reminder_management'))support.push(t('sup_checkup'));
  if(checked('no_support'))support.push(t('sup_none'));
  if(checked('arrange_call')&&val('callback_date'))support.push(t('sup_callback'));
  const countryLabel=val('country')==='Deutschland'?t('country_de'):val('country')==='Österreich'?t('country_at'):'';
  /* doctor details entered by the user (collected when prescription management is chosen) */
  const docRows=[];
  const addDoc=(label,value)=>{ if(value) docRows.push(`<div class="row"><span>${label}</span><span class="rv-right">${esc(value)}</span></div>`); };
  addDoc(t('rv_name'),[val('doctor_first'),val('doctor_last')].filter(Boolean).join(' '));
  addDoc(t('doc_practice'),val('doctor_street2'));
  addDoc(t('doc_street'),val('doctor_street'));
  addDoc(t('doc_postcode'),val('doctor_postcode'));
  addDoc(t('doc_phone'),val('doctor_phone')?phoneFull('doctor_phone'):'');
  addDoc(t('doc_email'),val('doctor_email'));
  addDoc(t('doc_fax'),val('doctor_fax')?phoneFull('doctor_fax'):'');
  if(checked('arrange_call')&&val('callback_date')) addDoc(t('callback_when'),val('callback_date'));
  const docBlock = docRows.length ? `
    <div class="review-block">
      <h4>${t('doctor_details_h')} <a data-goto="3">${t('rv_edit')}</a></h4>
      ${docRows.join('')}
    </div>` : '';
  $('reviewArea').innerHTML=`
    <div class="review-block">
      <h4>${t('rv_about')} <a data-goto="1">${t('rv_edit')}</a></h4>
      <div class="row"><span>${t('rv_name')}</span><span>${esc(val('firstname'))} ${esc(val('lastname'))}</span></div>
      <div class="row"><span>${t('rv_role')}</span><span>${val('customer_type')==='Caregiver'?t('opt_caregiver'):t('opt_patient')}</span></div>
      <div class="row"><span>${t('rv_email')}</span><span>${esc(val('email'))}</span></div>
      <div class="row"><span>${t('rv_contact')}</span><span>${esc(comm)||t('rv_dash')}</span></div>
      <div class="row"><span>${t('rv_second')}</span><span>${radio('second_person')==='Yes'?esc(val('second_contact_person')+' '+val('second_contact_surname')):t('rv_no')}</span></div>
    </div>
    <div class="review-block">
      <h4>${t('rv_med')} <a data-goto="2">${t('rv_edit')}</a></h4>
      <div class="row"><span>${t('rv_medication')}</span><span>${HS.med.medicine}, ${HS.med.dose}</span></div>
      <div class="row"><span>${t('rv_firstdose')}</span><span>${esc(val('first_medication_date'))||t('rv_dash')}</span></div>
      <div class="row"><span>${t('rv_freq')}</span><span>${freqLabels[radio('reminder_freq')]||t('rv_dash')}</span></div>
    </div>
    <div class="review-block">
      <h4>${t('rv_delivery')} <a data-goto="3">${t('rv_edit')}</a></h4>
      <div class="row"><span>${t('rv_country')}</span><span>${esc(countryLabel)||t('rv_dash')}</span></div>
      <div class="row"><span>${t('rv_support')}</span><span class="rv-right">${support.join(', ')||t('rv_dash')}</span></div>
    </div>${docBlock}`;
  document.querySelectorAll('#reviewArea a[data-goto]').forEach(a=>a.addEventListener('click',()=>showStep(+a.dataset.goto)));
}

/* ============================================================
   BUILD 3 PAYLOADS + SUBMIT
   ============================================================ */
function context(){ return { pageUri:location.href, pageName:document.title, hutk:(document.cookie.match(/hubspotutk=([^;]+)/)||[])[1]||undefined }; }
function payloadRegistration(){
  const f=[];
  f.push(field('customer_type',val('customer_type')));
  f.push(field('firstname',val('firstname')));
  f.push(field('lastname',val('lastname')));
  f.push(field('email',val('email')));
  const comm=multi('#comm_prefs input'); if(comm) f.push(field('communication_preference',comm));
  if(val('patient_whatsapp')) f.push(field('patient_whatsapp',phoneFull('patient_whatsapp')));
  if(val('patient_phone'))    f.push(field('patient_phone',phoneFull('patient_phone')));
  if(val('patient_sms'))      f.push(field('patient_sms',phoneFull('patient_sms')));
  f.push(field('would_you_like_the_medication_reminders_to_be_sent_to_a_second_person_',radio('second_person')));
  if(radio('second_person')==='Yes'){
    if(val('second_contact_person'))  f.push(field('second_contact_person',val('second_contact_person')));
    if(val('second_contact_surname')) f.push(field('second_contact_surname',val('second_contact_surname')));
    if(val('caregiver_relationship')) f.push(field('caregiver_relationship',val('caregiver_relationship')));
    const cg=multi('#cg_comm_prefs input'); if(cg) f.push(field('caregiver_communication_preferences',cg));
    if(val('second_contact_email'))    f.push(field('second_contact_email',val('second_contact_email')));
    if(val('second_contact_whatsapp')) f.push(field('second_contact_whatsapp',phoneFull('second_contact_whatsapp')));
    if(val('second_contact_phone'))    f.push(field('second_contact_phone',phoneFull('second_contact_phone')));
    if(val('caregiver_sms'))           f.push(field('caregiver_sms',phoneFull('caregiver_sms')));
  }
  if(checked('create_an_account')){ f.push(field('create_an_account','true')); f.push(field('account_email',val('email'))); }
  f.push(field('agree_to_terms','true'));
  f.push(field('medicine',HS.med.medicine));
  return {fields:f, context:context()};
}
function payloadMedical(){
  const f=[];
  f.push(field('medicine',HS.med.medicine));
  f.push(field('medication_dose__open_field_',HS.med.dose));
  f.push(field('medication_frequency',HS.med.frequency));
  f.push(field('medication_administration',HS.med.administration));
  f.push(field('confirmation_medication___dosage_is_correct','true'));
  if(val('first_medication_date')) f.push(field('uhp_first_medication_date',toEpoch(val('first_medication_date'))));
  if(val('other_medication')) f.push(field('does_the_patient_take_any_other_medication_',val('other_medication')));
  if(radio('reminder_freq')) f.push(field('uhp_medication_reminder_preferences',radio('reminder_freq')));
  f.push(field('email',val('email')));
  return {fields:f, context:context()};
}
function payloadDelivery(){
  const f=[];
  const at=val('country')==='Österreich', delivery=checked('delivery_management'), rx=checked('prescription_management');
  const consentGiven=checked('delivery_consent'), hcpGiven=checked('hcp_consent');
  f.push(field('h_country',val('country')));
  /* Keep the new shared country property while also satisfying the delivery
     form's required legacy country field. Both receive the identical value. */
  f.push(field('doctors_country_brinsupri',val('country')));
  f.push(field('delivery_management',delivery?'true':'false'));
  f.push(field('prescription_management',rx?'true':'false'));
  f.push(field('check_up_reminder_management',checked('check_up_reminder_management')?'true':'false'));
  f.push(field('i_don_t_want_hcp_support_right_now',checked('no_support')?'true':'false'));
  /* Form 3 marks all four country consents + appointment date REQUIRED; endpoint ignores
     conditional logic, so send every one — only the genuinely-given consent is 'true'. */
  const deliveryConsent=(delivery||rx)&&consentGiven;
  f.push(field('delivery_consent_germany',(!at&&deliveryConsent)?'true':'false'));
  f.push(field('delivery_consent_austria',( at&&deliveryConsent)?'true':'false'));
  f.push(field('hcp_consent',         (!at&&rx&&hcpGiven)?'true':'false'));
  f.push(field('hcp_consent_austria', ( at&&rx&&hcpGiven)?'true':'false'));
  f.push(field('when_is_your_next_doctor_s_appointment_scheduled_',(checked('check_up_reminder_management')&&val('appointment_date'))?toEpoch(val('appointment_date')):((rx&&val('callback_date'))?toEpoch(val('callback_date')):'false')));
  /* Shared German/Austrian pharmacy-choice flow. */
  if((delivery||rx) && consentGiven){
    const ph=radio('pharmacy_choice');
    if(ph) f.push(field('consent_for_h_pharmacy_germany', ph));   // 'yes' = H+ pharmacy · 'no' = own pharmacy
    if(ph==='no'){
      if(val('chosen_pharmacy_name'))     f.push(field('chosen_pharmacy_name',val('chosen_pharmacy_name')));
      if(val('chosen_pharmacy_street'))   f.push(field('chosen_pharmacy_street',val('chosen_pharmacy_street')));
      if(val('chosen_pharmacy_city'))     f.push(field('chosen_pharmacy_city',val('chosen_pharmacy_city')));
      if(val('chosen_pharmacy_postcode')) f.push(field('chosen_pharmacy_post_code',val('chosen_pharmacy_postcode')));
    }
  }
  if(rx){
    if(val('doctor_first'))    f.push(field('doctor_s_first_name',val('doctor_first')));
    if(val('doctor_last'))     f.push(field('doctor_s_last_name',val('doctor_last')));
    if(val('doctor_street'))   f.push(field('doctor_s_street_address',val('doctor_street')));
    if(val('doctor_street2'))  f.push(field('doctor_s_street_address_2',val('doctor_street2')));
    if(val('doctor_postcode')) f.push(field('doctor_s_post_code',val('doctor_postcode')));
    if(val('doctor_phone'))    f.push(field('doctor_s_phone_number',phoneFull('doctor_phone')));
    if(val('doctor_email'))    f.push(field('work_email',val('doctor_email')));
    if(val('doctor_fax'))      f.push(field('doctor_s_fax',phoneFull('doctor_fax')));
  }
  f.push(field('email',val('email')));
  return {fields:f, context:context()};
}
async function submitOne(guid,payload){
  const r=await fetch(endpoint(guid),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
  if(!r.ok){ const x=await r.text().catch(()=> ''); throw new Error(`Form ${guid}: ${r.status} ${x.slice(0,180)}`); }
  return r.json();
}
/* progressive submit: each form is sent as its step completes; re-sent only if its
   data changed since the last send (dedup by payload signature → no duplicate events). */
const lastSent={registration:'',medical:'',delivery:''};
const payloadFor={registration:payloadRegistration,medical:payloadMedical,delivery:payloadDelivery};
async function sendStep(key){
  const p=buildPayload(key);                                 // adds clears + email-lock (see F1/F2 fixes)
  const sig=JSON.stringify(p.fields);
  if(sig===lastSent[key]) return true;                       // unchanged since last send
  try{ await submitOne(HS.forms[key],p); lastSent[key]=sig; return true; }
  catch(e){ console.warn('send failed:',key,e); return false; }
}
$('submitBtn').addEventListener('click',async ()=>{
  if(!validateStep(1)){ showStep(1); return; }
  if(!validateStep(2)){ showStep(2); return; }
  if(!validateStep3All()){ return; }
  const btn=$('submitBtn'); btn.disabled=true; btn.textContent=t('submitting');
  $('submitError').style.display='none';
  // ensure all three are sent (no-op for any already sent unchanged)
  const r1=await sendStep('registration'), r2=await sendStep('medical'), r3=await sendStep('delivery');
  if(r1&&r2&&r3){
    $('hplusForm').style.display='none'; $('progressWrap').style.display='none';
    $('successScreen').style.display='block';
    $('successScreen').scrollIntoView({behavior:'smooth',block:'center'});
  }else{
    btn.disabled=false; btn.textContent=t('submit_btn');
    const box=$('submitError'); box.style.display='block'; box.textContent=t('submit_err');
  }
});
/* live phone/email format feedback on blur (and when the country code is switched) */
function validateOneField(inp){
  const f=inp.closest('.field'), v=inp.value.trim();
  f.querySelectorAll('.err-msg.fmt').forEach(e=>e.remove()); f.classList.remove('invalid');
  if(v && !formatOk(inp)){ f.classList.add('invalid'); ensureFmtErr(f,t(formatErrorKey(inp))); }
}
document.querySelectorAll('input[data-validate]').forEach(inp=>inp.addEventListener('blur',()=>validateOneField(inp)));
document.querySelectorAll('.cc-select').forEach(sel=>sel.addEventListener('change',()=>{
  const inp=$(sel.id.replace(/_cc$/,'')); if(inp && inp.value.trim()) validateOneField(inp);
}));

/* ============================================================
   PERSISTENCE — autofill on return + drop-out capture
   Field values are saved to THIS browser only (localStorage).
   Nothing leaves the device until a step's HubSpot form submits.
   (Same-device autofill; not cross-device known-contact prefill.)
   ============================================================ */
const LS_KEY='hplus_form_v1';
const _ctrls=()=>[...document.querySelectorAll('#hplusForm input,#hplusForm select,#hplusForm textarea')];
function saveState(){
  try{
    const s={};
    _ctrls().forEach((el,i)=>{
      if(el.type==='checkbox'||el.type==='radio'){ if(el.checked) s[i]=1; }
      else if(el.value!==''){ s[i]=el.value; }
    });
    localStorage.setItem(LS_KEY,JSON.stringify(s));
  }catch(e){}
}
function restoreState(){
  let s=null; try{ s=JSON.parse(localStorage.getItem(LS_KEY)||'null'); }catch(e){}
  if(!s) return false;
  const cs=_ctrls();
  Object.keys(s).forEach(k=>{ const el=cs[+k]; if(!el) return;
    if(el.type==='checkbox'||el.type==='radio'){ el.checked=!!s[k]; }
    else{ el.value=s[k]; }
  });
  // re-render every conditional UI element to match the restored values
  document.querySelectorAll('.choice input').forEach(inp=>{ const c=inp.closest('.choice'); if(c) c.classList.toggle('selected',inp.checked); });
  try{ syncCommFields(); syncCgCommFields(); }catch(e){}
  syncSecondPerson(); syncOptions(); syncConsentVisibility();
  return true;
}

/* drop-out capture: on tab close / hide, best-effort submit any completed-but-
   unsent step via sendBeacon (fire-and-forget, no CORS preflight). Gates are
   silent (no DOM mutation) so a mere tab-switch never paints validation errors.
   HubSpot upserts by email, so a beacon + a later full submit = one contact. */
function _canFlush(n){
  if(n===1) return !!(val('email')&&val('firstname')&&val('lastname')&&val('customer_type'));
  if(n===2) return !!(val('email')&&val('first_medication_date')&&checked('confirmation_medication'));
  if(n===3) return !!(val('email')&&val('country')&&(checked('delivery_management')||checked('prescription_management')||checked('check_up_reminder_management')||radio('reminder_freq')!==''||checked('no_support')));
  return false;
}
function beaconStep(key){
  try{
    const p=buildPayload(key);
    const sig=JSON.stringify(p.fields);
    if(sig===lastSent[key]) return;                       // already sent, unchanged
    const blob=new Blob([JSON.stringify(p)],{type:'application/json'});
    if(navigator.sendBeacon(endpoint(HS.forms[key]),blob)) lastSent[key]=sig;
  }catch(e){}
}

/* ---- F1: clear removed values ----
   buildPayload() wraps a step's payload so any field that was sent earlier but
   is now emptied is explicitly re-sent as '' to clear it in the backend.
   (An edited email intentionally creates a new contact — no email lock.)
   Backend-only; no UI change. */
const sentFields={registration:new Set(),medical:new Set(),delivery:new Set()};
function withClears(key,p){
  const present=new Set(p.fields.map(f=>f.name));
  sentFields[key].forEach(n=>{ if(!present.has(n)) p.fields.push(field(n,'')); });  // re-send emptied fields as ''
  p.fields.forEach(f=>sentFields[key].add(f.name));
  return p;
}
function buildPayload(key){ return withClears(key,payloadFor[key]()); }
function flushOnExit(){
  if(_canFlush(1)) beaconStep('registration');
  if(_canFlush(2)) beaconStep('medical');
  if(_canFlush(3)) beaconStep('delivery');
  saveState();
}
window.addEventListener('pagehide',flushOnExit);
document.addEventListener('visibilitychange',()=>{ if(document.visibilityState==='hidden') flushOnExit(); });

/* init */
applyLang(currentLang);
restoreState();                                            // autofill from a prior visit (this browser)
syncOptions(); syncConsentVisibility(); syncSecondPerson(); setupDates();
$('hplusForm').addEventListener('input',saveState);        // persist as the patient types
$('hplusForm').addEventListener('change',saveState);

})();
</script>
